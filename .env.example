# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://agentcheck:agentcheck@localhost:5432/agentcheck

# Gemini (free key from aistudio.google.com)
GEMINI_API_KEY=
# Model names. Leave blank to use the defaults in backend/app/config.py
# (gemini-3.5-flash-lite for answers and judging, gemini-embedding-2 for embeddings).
# Free tier: Flash Lite 15 RPM / 500 RPD; 3.8 Flash only 5 RPM / 20 RPD (too small to judge).
# Confirm each has a free tier for your key at aistudio.google.com (rate-limit page).
GEMINI_MODEL_FAST=
GEMINI_MODEL_JUDGE=
GEMINI_EMBEDDING_MODEL=
# Must match the vector(...) size in the migration. Changing it needs a new migration.
EMBEDDING_DIM=768

# Cloudflare Turnstile (Phase 6)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Salt for hashing visitor IPs
IP_HASH_SALT=change-me

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
