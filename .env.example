# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://agentready:agentready@localhost:5432/agentready

# Gemini (free key from aistudio.google.com)
GEMINI_API_KEY=
# Pick current free-tier model names from Google AI Studio / the Gemini API docs.
GEMINI_MODEL_FAST=
GEMINI_MODEL_JUDGE=
GEMINI_EMBEDDING_MODEL=

# Cloudflare Turnstile (Phase 6)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Salt for hashing visitor IPs
IP_HASH_SALT=change-me

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
